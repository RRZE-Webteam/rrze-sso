{
    "name": "rrze/rrze-sso",
    "description": "Single Sign-On SAML integration for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "humanmade/psalm-plugin-wordpress": "^3.1",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "RRZE\\SSO\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RRZE\\SSO\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "analyse": "psalm --no-cache --threads=1",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2.27"
        },
        "sort-packages": true
    }
}
